# GEMINI_API_KEY: clave de Google AI Studio para la síntesis con IA.
# Sin ella la app funciona, pero el botón de síntesis aparece desactivado.
# En Vercel: Project Settings > Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL (opcional): modelo de Gemini. Por defecto gemini-4-hydrogen.
# GEMINI_MODEL="gemini-4-hydrogen"
