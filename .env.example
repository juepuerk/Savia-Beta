# --- Proveedores de IA ---------------------------------------------------
# Savia prueba primero OmniRoute y, si falla o no está configurado, usa Gemini.
# Configura al menos uno para activar la síntesis con IA.

# OMNIROUTE_BASE_URL: URL del endpoint compatible con OpenAI de tu instancia de OmniRoute,
# terminada en /v1 (ej. http://localhost:20128/v1).
OMNIROUTE_BASE_URL="MY_OMNIROUTE_URL"
# OMNIROUTE_API_KEY: clave creada en el panel de OmniRoute (opcional si tu instancia no la exige).
OMNIROUTE_API_KEY="MY_OMNIROUTE_API_KEY"
# OMNIROUTE_MODEL: modelo o combo definido en OmniRoute (por defecto "auto").
OMNIROUTE_MODEL="auto"

# GEMINI_API_KEY: respaldo directo con Gemini (opcional si usas OmniRoute).
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# GEMINI_MODEL: modelo de Gemini (por defecto gemini-4-hydrogen).
# GEMINI_MODEL="gemini-4-hydrogen"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
